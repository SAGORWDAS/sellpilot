APP_URL=http://localhost:3000

# Postgres. Local: docker run --name sellpilot-db -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/sellpilot
TEST_DATABASE_URL=postgresql://postgres:dev@localhost:5432/sellpilot_test

# 32+ random bytes, base64. Rotating this invalidates every session.
SESSION_SECRET=replace-me-with-openssl-rand-base64-32

# Envelope key for mailbox credentials and API keys. Never reuse SESSION_SECRET.
SECRETS_KEY=replace-me-with-openssl-rand-base64-32

# OpenAI. Bulk model does copy + classification; smart model does strategy only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL_BULK=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5

# Serper.dev — Google Search + Places for lead discovery (~$1/1k searches).
SERPER_API_KEY=

# 1 = full pipeline runs but emails are logged, never sent.
EMAIL_DRY_RUN=0

# Public signup. Keep false until you want customers.
ALLOW_SIGNUP=false